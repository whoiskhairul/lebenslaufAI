{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Django Backend",
            "type": "shell",
            "command": "python manage.py runserver",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "isBackground": true
        },
        {
            "label": "Vite Frontend",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "isBackground": true
        },
        {
            "label": "Start All",
            "dependsOn": [
                "Django Backend",
                "Vite Frontend"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}